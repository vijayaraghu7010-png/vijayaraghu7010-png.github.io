node_modules
dist
.env
.env.*.local
.env.local

# A staging environment's own settings. Separate from .env on purpose:
# .env feeds the real shop's build, and a staging URL finding its way
# in there would point the live site at the wrong database.
.env.staging

# What a staging build produces. Kept apart from dist/ so that the
# thing deployed to the real site can never be a staging build that
# happened to be the last one made.
dist-staging
.vercel
.netlify
server/data
*.log
.DS_Store
Thumbs.db
.remember

# The Supabase CLI's own scratch directory. It caches which CLI
# version it last saw; nothing in it describes this project.
supabase/.temp/

# Reports are generated, not source. They live on disk for whoever
# asked for one and stay out of the repository's history.
*-report.pdf
